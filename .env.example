NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
FIREBASE_PROJECT_ID=patternly-app-sandbox
FIREBASE_AUTH_ISSUER=https://securetoken.google.com/patternly-app-sandbox
# Set only for local Firebase Auth Emulator runs; never use in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
REPORT_RATE_LIMIT_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
DELETION_PSEUDONYM_KEYS_JSON=[{"version":"v1","status":"active","keyBase64":"replace-with-32-byte-base64-secret"}]
REPORT_RATE_LIMIT_MAX=5
REPORT_RATE_LIMIT_WINDOW_SECONDS=3600
ACCOUNT_DATA_EXPORT_RATE_LIMIT_MAX=3
ACCOUNT_DATA_EXPORT_RATE_LIMIT_WINDOW_SECONDS=3600
ACCOUNT_DATA_EXPORT_MAX_SERIALIZED_BYTES=5242880
PRIVACY_RESPONSE_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
PRIVACY_AUDIT_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_PRIVACY_ORIGIN=https://example.com
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=465
SMTP_USERNAME=replace-with-google-workspace-smtp-username
SMTP_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
SMTP_FROM_EMAIL=privacy@example.com
SMTP_FROM_NAME=Patternly
SMTP_REPLY_TO=privacy@example.com
# Exact HTTPS origin of the admin web application: no path, query, fragment or credentials.
ADMINISTRATOR_EMAIL=admin@example.com
ADMIN_WEB_ORIGIN=https://patternly-app-sandbox.web.app
REVENUECAT_API_BASE_URL=https://api.revenuecat.com
# Required in production; webhook Authorization must equal this value exactly.
REVENUECAT_WEBHOOK_SECRET=replace-with-revenuecat-webhook-secret
REVENUECAT_APP_ID=replace-with-revenuecat-app-id
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_PRODUCT_ID=replace-with-revenuecat-product-id
REVENUECAT_WEBHOOK_ENVIRONMENT=PRODUCTION
CONTENT_CATALOG_ORIGIN=https://content.example.invalid
# Read-only directory containing published track artifacts. Required for admin question-bank inspection.
ADMIN_CONTENT_ROOT=/srv/patternly-content/artifacts
# Immutable release under ADMIN_CONTENT_ROOT/releases. Never inferred from directory ordering.
ADMIN_CONTENT_RELEASE_ID=patternly-launch-2026-08-25-01
